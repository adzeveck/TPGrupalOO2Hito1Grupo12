<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Festival" table="festival">
    	<!-- ID -->
        <id name="idFestival" column="idFestival">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->       
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="temporada" column="temporada" type="string" not-null="true"/>
        <property name="fechaInicio" column="fechaInicio" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaFin" column="fechaFin" type="java.time.LocalDate" not-null="true"/> 
        <property name="costoSuperficie" column="costoSuperficie" type="double" not-null="true"/>
        <property name="plusElectricidad" column="plusElectricidad" type="double" not-null="true"/>
        <property name="costoMontaje" column="costoMontaje" type="double" not-null="true"/>
        <property name="sueldoBase" column="sueldoBase" type="double" not-null="true"/> 
        <property name="valorAnioAntiguedad" column="valorAnioAntiguedad" type="double" not-null="true"/>
        
        <set name="UnidadDeVenta" table="unidad_de_venta" order-by="id asc" inverse="true" lazy="true" fetch="select">
			<key column="idFestival" not-null="true"/>
			<one-to-many class="datos.UnidadDeVenta"/>
		</set>
    </class>
</hibernate-mapping>