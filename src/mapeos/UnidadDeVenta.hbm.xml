<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

	<class name="datos.UnidadDeVenta" table="unidad_de_venta">

		<id name="id" column="id">
			<generator class="identity" />
		</id>

		<property name="nombre"     column="nombre"     type="string" />
		<property name="superficie" column="superficie" type="double" />
		<property name="codigo"     column="codigo"     type="string" />

		<!-- Nullable por ahora: todavia no todos los flujos de alta de UnidadDeVenta
		     setean el festival. Cuando lo hagan, se puede pasar a not-null="true".

		     lazy="false" porque el Dao cierra la sesion antes de devolver: si quedara
		     como proxy, cualquier uso del festival afuera del Dao tiraria
		     LazyInitializationException (incluso un println, porque el toString() de
		     UnidadDeVenta imprime el festival).
		     fetch="select" para que lo traiga con un SELECT aparte y no agregue un
		     join a las consultas agrupadas. -->
		<many-to-one name="festival" class="datos.Festival" column="idFestival"
			lazy="false" fetch="select" />

		<!-- El responsable a cargo: UN Personal. La FK va en esta tabla.
		     Nullable, igual que festival: el alta todavia no lo pide.

		     lazy="false" por dos motivos:
		     1) el Dao cierra la sesion antes de devolver, asi que usarlo afuera
		        tiraria LazyInitializationException;
		     2) mas sutil: si queda lazy, Hibernate crea un proxy de Personal (no
		        sabe la subclase sin ir a la base). Como el responsable tambien
		        esta en lstPersonal, la garantia de identidad hace que la coleccion
		        devuelva ESE proxy, y entonces "instanceof Cocinero" da false
		        aunque en la base sea un cocinero. Con lazy="false" Hibernate lo
		        trae de una y la instancia es de la subclase real. -->
		<many-to-one name="responsable" class="datos.Personal" column="idResponsable"
			lazy="false" fetch="select" />
	
		
		<set name="lstPersonal" lazy="false">
    		<key column="idUnidad"/>
   	 		<one-to-many class="datos.Personal"/>
		</set>

		<set name="lstPlatos" inverse="true" cascade="all-delete-orphan" lazy="true">
			<key column="idUnidad" not-null="true"/>
			<one-to-many class="datos.Plato"/>
		</set>

		<joined-subclass name="datos.FoodTruck" table="food_truck">
			<key column="idUnidad" />
			<property name="patente" column="patente" type="string" />
			<property name="requiereElectricidad" column="requiereElectricidad"
				type="boolean" />
		</joined-subclass>

		<joined-subclass name="datos.PuestoDesarmable" table="puesto_desarmable">
			<key column="idUnidad" />
			<property name="cantCarpas"    column="cantCarpas"    type="int" />
			<property name="tiempoMontaje" column="tiempoMontaje" type="int" />
		</joined-subclass>

	</class>
</hibernate-mapping>
