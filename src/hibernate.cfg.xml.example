<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
<session-factory>
<!--
	Este es un TEMPLATE. Copiá este archivo como "hibernate.cfg.xml" (sin el .example)
	en esta misma carpeta, y completá TU usuario/contraseña de MySQL local.
	El archivo "hibernate.cfg.xml" real está en .gitignore: no se sube al repo,
	cada integrante tiene el suyo con sus propias credenciales.
-->
<property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
<property name="connection.url">jdbc:mysql://127.0.0.1:3306/epicentro_gourmet?serverTimezone=America/Argentina/Buenos_Aires&amp;createDatabaseIfNotExist=true</property>
<property name="connection.username">YOUR_USERNAME</property>
<property name="connection.password">YOUR_PASSWORD</property>
<property name="connection.pool_size">1</property>
<property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>
<property name="show_sql">true</property><!-- en true muestra el SQL generado en consola -->
<property name="format_sql">true</property><!-- en true se ve más legible el SQL en consola -->
<property name="hibernate.hbm2ddl.auto">update</property><!-- crea/actualiza las tablas solo, según los .hbm.xml -->
<!-- Mapeo Entidades: descomenten la suya cuando tengan su hibernate.cfg.xml local armado -->
<!-- <mapping resource="mapeos/Festival.hbm.xml" /> -->
<!-- <mapping resource="mapeos/UnidadDeVenta.hbm.xml" /> -->
<!-- <mapping resource="mapeos/Personal.hbm.xml" /> -->
<!-- <mapping resource="mapeos/Plato.hbm.xml" /> -->
<!-- <mapping resource="mapeos/Pedido.hbm.xml" /> -->
<!-- <mapping resource="mapeos/DetallePedido.hbm.xml" /> -->
</session-factory>
</hibernate-configuration>